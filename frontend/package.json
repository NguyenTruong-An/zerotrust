{
  "name": "zerotrust-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.21.2",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "test:student-scores": "node --test tests/student-score-dashboard.test.mjs",
    "test:portal-route": "node --test tests/portal-route.test.mjs",
    "check": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "keycloak-js": "26.2.5",
    "lucide-react": "^1.34.0",
    "next": "16.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "jsdom": "26.1.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "11.0.1"
    }
  },
  "type": "module"
}
