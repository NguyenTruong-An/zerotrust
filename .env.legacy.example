# Copy to an operator-owned env file OUTSIDE Git, then set LEGACY_STATE_DIR.
# This selects the legacy candidate only when passed with -f compose.legacy.yaml.
COMPOSE_PROJECT_NAME=zerotrust-legacy-integration-20261026
COMPOSE_PARALLEL_LIMIT=1

# Relative paths resolve from the Compose project directory, NOT this env file.
# An operator may replace this example with their own absolute private directory.
# Never point it at .local-demo or operational/QA/frozen database storage.
LEGACY_STATE_DIR=../zerotrust-private/legacy-runtime

# Source-only validation needs no credentials or private assets:
# docker compose --project-name zerotrust-legacy-integration-20261026 --env-file .env.legacy.example -f compose.legacy.yaml --profile legacy config --no-env-resolution --quiet
# Normal config/build/start additionally requires the prepared external runtime files.
# Ordinary start uses scripts/legacy/operate.py; never use bootstrap/import as restart.
