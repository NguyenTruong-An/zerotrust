# Development/Demo uses generated credentials in ignored .local-demo/.
# No passwords, tokens or certificate keys belong in this file.
COMPOSE_PROJECT_NAME=zerotrust-demo
COMPOSE_PARALLEL_LIMIT=1

# Separate legacy candidate; configure this in a private --env-file, never use .local-demo.
# LEGACY_STATE_DIR=/absolute/private/path/runtime

# Optional runtime variable reference: .env.runtime.example (never auto-loaded).
