# Copy to .env for local development. Never commit real values.
SPRING_PROFILES_ACTIVE=dev
RISK_DB_URL=jdbc:mysql://localhost:3307/risk_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
RISK_DB_USERNAME=risk_service
RISK_DB_PASSWORD=replace-with-a-long-random-local-password
RISK_DB_ROOT_PASSWORD=replace-with-a-different-long-random-local-password
RISK_DEVICE_FINGERPRINT_PEPPER=replace-with-at-least-32-random-characters
RISK_AUTH_HISTORY_PEPPER=replace-with-a-different-at-least-32-character-random-value
RISK_AUTH_SUBJECT_MEDIUM_MINIMUM=3
RISK_AUTH_SUBJECT_HIGH_MINIMUM=5
RISK_AUTH_IP_MEDIUM_MINIMUM=10
RISK_AUTH_IP_HIGH_MINIMUM=20
RISK_AUTH_HISTORY_MEDIUM_SCORE=50
RISK_AUTH_HISTORY_HIGH_SCORE=100
RISK_REDIS_HOST=localhost
RISK_REDIS_PORT=6379
RISK_REDIS_PASSWORD=replace-with-a-long-random-redis-password
RISK_REDIS_SSL=false
RISK_BIND_ADDRESS=0.0.0.0
RISK_JWT_ISSUER_URI=http://localhost:8080/realms/DoAn
RISK_JWT_JWK_SET_URI=http://localhost:8180/realms/DoAn/protocol/openid-connect/certs
