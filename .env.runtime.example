RISK_TEMPORAL_MINIMUM_HOUR_FREQUENCY=0.20
RISK_TEMPORAL_MEDIUM_SCORE=50
RISK_TEMPORAL_HIGH_SCORE=100
RISK_REDIS_HOST=
