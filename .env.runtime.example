# Optional runtime configuration reference; NOT automatically loaded by any profile.
# Actual integration configuration is generated privately; do not point test apps at operational databases.
# Blank values require explicit private configuration. No passwords, peppers or local user paths belong here.
SPRING_PROFILES_ACTIVE=prod
RISK_DB_URL=
RISK_DB_USERNAME=risk_service
RISK_DB_PASSWORD=
RISK_DB_ROOT_PASSWORD=
