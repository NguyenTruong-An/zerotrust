# Inputs for future authorized private rehearsal. These are not rc.py config fields.
# Fill project/region/zone/CIDR from read-only Cloud preflight before running a plan.
PROJECT_ID=
REGION=
ZONE=
SUBNET_CIDR=
NETWORK=zt-academic-private
SUBNET=zt-academic-private
VM_NAME=zt-academic-private
ADDRESS_NAME=zt-academic-static
MACHINE_TYPE=e2-custom-4-8192
BOOT_DISK_GB=40
BOOT_DISK_TYPE=pd-balanced
STATIC_EXTERNAL_IP=
# Derive only after the actual static IP exists.
PORTAL_HOST=
AUTH_HOST=
# PORTAL_HOST=portal.${STATIC_EXTERNAL_IP}.sslip.io
# AUTH_HOST=auth.${STATIC_EXTERNAL_IP}.sslip.io
RELEASE_ID=
PRIVATE_ORIGIN_PORT=34443
PUBLIC_HTTPS_PORT=443
STATE_DIR=/var/lib/zerotrust/zerotrust-academic-prod
FULLCHAIN_FILE=
PRIVATE_KEY_FILE=
EDGE_CA_FILE=
# Candidate references are recorded in the handoff. Approval/promotion remains pending.
APPROVED_KEYCLOAK_DIGEST=
APPROVED_MYSQL84_DIGEST=
APPROVED_MYSQL80_DIGEST=
# Credentials/OTP seeds/tokens do not belong in this file.
