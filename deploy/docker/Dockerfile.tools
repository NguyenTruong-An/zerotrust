FROM eclipse-temurin:17.0.21_9-jdk-jammy@sha256:057a0daec60e87c96571bf5c9c7792065bcb19e804d584cd37d4144038a35717
ARG SOURCE_REVISION=unknown
ARG SOURCE_SNAPSHOT=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REVISION io.zerotrust.source.snapshot=$SOURCE_SNAPSHOT
RUN apt-get update && apt-get install -y --no-install-recommends apt=2.4.15ubuntu0.1 libapt-pkg6.0=2.4.15ubuntu0.1 python3 python3-pip python3-venv && rm -rf /var/lib/apt/lists/* && \
    python3 -m venv /opt/tools && \
    /opt/tools/bin/pip install --no-cache-dir --upgrade pip==26.3 setuptools==84.2.1 && \
    /opt/tools/bin/pip install --no-cache-dir cryptography==50.0.2 PyMySQL==1.1.1
WORKDIR /tools
COPY deploy/demo/ /tools/
COPY database/ /source/database/
ENTRYPOINT ["/opt/tools/bin/python","/tools/bootstrap.py"]
