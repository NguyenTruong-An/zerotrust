{
  "version": 1,
  "environment": "production",
  "not_a_deployment": true,
  "entries": {
    "school-db-runtime": {
      "file": "/srv/zerotrust-secrets/production/school-db-runtime",
      "mode": "0400",
      "owner": "backend runtime UID; verify candidate",
      "target": "spring.datasource.password",
      "consumer": "backend"
    },
    "portal-identity-client": {
      "file": "/srv/zerotrust-secrets/production/portal-identity-client",
      "mode": "0400",
      "owner": "backend runtime UID; verify candidate",
      "target": "keycloak.admin.client-secret",
      "consumer": "backend"
    },
    "portal-risk-client": {
      "file": "/srv/zerotrust-secrets/production/portal-risk-client",
      "mode": "0400",
      "owner": "backend runtime UID; verify candidate",
      "target": "app.risk-admin.client-secret",
      "consumer": "backend"
    },
    "portal-tls-password": {
      "file": "/srv/zerotrust-secrets/production/portal-tls-password",
      "mode": "0400",
      "owner": "backend runtime UID; verify candidate",
      "target": "server.ssl.key-store-password",
      "consumer": "backend"
    },
    "portal-tls-keystore": {
      "file": "/srv/zerotrust-secrets/production/portal-tls-keystore",
      "mode": "0400",
      "owner": "backend runtime UID; verify candidate",
      "target": "portal-tls.p12",
      "consumer": "backend"
    },
    "risk-db-runtime": {
      "file": "/srv/zerotrust-secrets/production/risk-db-runtime",
      "mode": "0400",
      "owner": "risk runtime UID; verify candidate",
      "target": "spring.datasource.password",
      "consumer": "risk"
    },
    "risk-redis-auth": {
      "file": "/srv/zerotrust-secrets/production/risk-redis-auth",
      "mode": "0400",
      "owner": "risk runtime UID; verify candidate",
      "target": "spring.data.redis.password",
      "consumer": "risk"
    },
    "device-pepper": {
      "file": "/srv/zerotrust-secrets/production/device-pepper",
      "mode": "0400",
      "owner": "risk runtime UID; verify candidate",
      "target": "risk.device-fingerprint.pepper",
      "consumer": "risk"
    },
    "history-pepper": {
      "file": "/srv/zerotrust-secrets/production/history-pepper",
      "mode": "0400",
      "owner": "risk runtime UID; verify candidate",
      "target": "risk.authentication-history.pepper",
      "consumer": "risk"
    },
    "risk-tls-password": {
      "file": "/srv/zerotrust-secrets/production/risk-tls-password",
      "mode": "0400",
      "owner": "risk runtime UID; verify candidate",
      "target": "server.ssl.key-store-password",
      "consumer": "risk"
    },
    "risk-tls-keystore": {
      "file": "/srv/zerotrust-secrets/production/risk-tls-keystore",
      "mode": "0400",
      "owner": "risk runtime UID; verify candidate",
      "target": "risk-tls.p12",
      "consumer": "risk"
    },
    "keycloak-runtime-config": {
      "file": "/srv/zerotrust-secrets/production/keycloak-runtime-config",
      "mode": "0400",
      "owner": "keycloak runtime UID; verify candidate",
      "target": "/run/public-demo/keycloak.conf",
      "consumer": "keycloak"
    },
    "risk-caller-client": {
      "file": "/srv/zerotrust-secrets/production/risk-caller-client",
      "mode": "0400",
      "owner": "keycloak runtime UID; verify candidate",
      "target": "risk-caller-client-secret",
      "consumer": "keycloak"
    },
    "keycloak-tls-keystore": {
      "file": "/srv/zerotrust-secrets/production/keycloak-tls-keystore",
      "mode": "0400",
      "owner": "keycloak runtime UID; verify candidate",
      "target": "keycloak-tls.p12",
      "consumer": "keycloak"
    },
    "gateway-tls-password": {
      "file": "/srv/zerotrust-secrets/production/gateway-tls-password",
      "mode": "0400",
      "owner": "gateway runtime UID; verify candidate",
      "target": "server.ssl.key-store-password",
      "consumer": "gateway"
    },
    "gateway-tls-keystore": {
      "file": "/srv/zerotrust-secrets/production/gateway-tls-keystore",
      "mode": "0400",
      "owner": "gateway runtime UID; verify candidate",
      "target": "gateway-tls.p12",
      "consumer": "gateway"
    },
    "redis-runtime-config": {
      "file": "/srv/zerotrust-secrets/production/redis-runtime-config",
      "mode": "0400",
      "owner": "redis runtime UID; verify candidate",
      "target": "/run/public-demo/redis.conf",
      "consumer": "redis"
    }
  },
  "bindings": {
    "backend": {
      "spring.datasource.password": "school-db-runtime",
      "keycloak.admin.client-secret": "portal-identity-client",
      "app.risk-admin.client-secret": "portal-risk-client",
      "server.ssl.key-store-password": "portal-tls-password",
      "portal-tls.p12": "portal-tls-keystore"
    },
    "risk": {
      "spring.datasource.password": "risk-db-runtime",
      "spring.data.redis.password": "risk-redis-auth",
      "risk.device-fingerprint.pepper": "device-pepper",
      "risk.authentication-history.pepper": "history-pepper",
      "server.ssl.key-store-password": "risk-tls-password",
      "risk-tls.p12": "risk-tls-keystore"
    },
    "keycloak": {
      "/run/public-demo/keycloak.conf": "keycloak-runtime-config",
      "risk-caller-client-secret": "risk-caller-client",
      "keycloak-tls.p12": "keycloak-tls-keystore"
    },
    "gateway": {
      "server.ssl.key-store-password": "gateway-tls-password",
      "gateway-tls.p12": "gateway-tls-keystore"
    },
    "redis": {
      "/run/public-demo/redis.conf": "redis-runtime-config"
    }
  },
  "keycloak_environment": {
    "PUBLIC_DEMO_MODE": "public-demo",
    "PUBLIC_DEMO_ACADEMIC_READ_ONLY": "true",
    "PUBLIC_DEMO_RISK_CALLER_SECRET_FILE": "/run/secrets/risk-caller-client-secret"
  },
  "forbidden_runtime_material": [
    "ca-private-key",
    "backup-decryption-key",
    "bootstrap-admin-password",
    "lab-export"
  ],
  "read_only_mounts": true,
  "native_ownership_acceptance_required": true
}
