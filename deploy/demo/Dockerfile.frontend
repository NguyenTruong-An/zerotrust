FROM node:24.16.0-bookworm-slim@sha256:ca520832af80fa37a57c14077ed0fcdd83b5aefccc356059fdc3a9a05b78ae1f AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY frontend/ ./
ARG KEYCLOAK_URL=https://localhost:8444
ARG KEYCLOAK_REALM=zerotrust-demo
ARG KEYCLOAK_CLIENT_ID=zerotrust-spa
ARG RUN_CHECKS=true
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_KEYCLOAK_URL=$KEYCLOAK_URL NEXT_PUBLIC_KEYCLOAK_REALM=$KEYCLOAK_REALM NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=$KEYCLOAK_CLIENT_ID
RUN if [ "$RUN_CHECKS" = "true" ]; then npm run check; fi && npx next build
FROM node:24.16.0-bookworm-slim@sha256:ca520832af80fa37a57c14077ed0fcdd83b5aefccc356059fdc3a9a05b78ae1f
ARG SOURCE_REVISION=unknown
ARG SOURCE_SNAPSHOT=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REVISION io.zerotrust.source.snapshot=$SOURCE_SNAPSHOT
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
USER node
CMD ["node","server.js"]
